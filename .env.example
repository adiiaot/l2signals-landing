DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/l2signals"
NEXT_PUBLIC_X_URL="https://x.com/l2signals"
NEXT_PUBLIC_FOUNDER_LINKEDIN="https://www.linkedin.com/in/aotayo"
NEXT_PUBLIC_FOUNDER_X="https://x.com/aot_ayo"
NEXT_PUBLIC_FOUNDER_PORTFOLIO="https://aot-network-portfolio.vercel.app/"
NEXT_PUBLIC_CONTACT_EMAIL="l2signalslab@gmail.com"
NEXT_PUBLIC_L2_WEB_API="https://l2signal-web-six.vercel.app"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=l2-signals
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Payments (/pay) ─────────────────────────────────────────────────────────
# Server-only. NEVER give these a NEXT_PUBLIC_ prefix — the browser bundle would
# ship them. Configure the same values in the Vercel project, not just locally.
#
# The plan price itself is NOT here: it is read from `config/payments` in Firestore,
# editable at l2signal_web → /dashboard/payments. Amounts are always recomputed
# server-side, so the browser can never choose what it pays.
# Secret key from the Paystack dashboard (Settings → API Keys). Live keys begin
# with `sk_live_`, test keys with `sk_test_` — paste the real value only in your
# local .env and in Vercel, never in a tracked file.
PAYSTACK_SECRET_KEY="PASTE_YOUR_PAYSTACK_SECRET_KEY_HERE"
# Standard Paystack accounts settle in NGN. Leave false unless your account is
# enabled for USD collection.
PAYSTACK_USD_ENABLED="false"
# Bot deep-link base used for optional Telegram identity, e.g.
# https://t.me/l2signals_bot  (the BOT, not the public channel). Empty hides the
# "Verify with Telegram" step and payments fall back to email matching.
NEXT_PUBLIC_TELEGRAM_BOT_URL=""
# Standalone Paystack storefront — card only, works with zero setup, but records no
# claim or email. Shown as a FALLBACK wherever the in-page card checkout is missing
# or fails. Public by design; override only if the storefront URL changes.
NEXT_PUBLIC_PAYSTACK_STOREFRONT_URL="https://paystack.shop/pay/l2signals-pro"

# ─── On-chain verification bridge (bot) ──────────────────────────────────────
# The bot's public API. The landing asks it to verify a USDT/USDC transfer; the bot
# also sends the invite. If it is unreachable (free tier asleep) the landing falls
# back to a pending payment for manual review — never an automatic grant.
BOT_API_URL="https://<bot-service>.onrender.com"
# Shared secret; must match PAYMENT_VERIFY_SECRET on the bot. Unset = bridge off.
PAYMENT_VERIFY_SECRET=""

# ─── Firebase Admin (write access for claims) ────────────────────────────────
# Same service account as l2signal_web. NEXT_PUBLIC_FIREBASE_PROJECT_ID above is
# reused as the project id.
FIREBASE_CLIENT_EMAIL=""
# Keep the escaped newlines exactly as Firebase issues them:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
